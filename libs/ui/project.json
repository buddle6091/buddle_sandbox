{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ui",
  "root": "libs/ui",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "tags": [
    "scope:ui",
    "type:ui"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/ui/**/*.ts",
          "libs/ui/**/*.tsx",
          "libs/ui/**/*.js",
          "libs/ui/**/*.jsx",
          "libs/ui/**/*.mjs",
          "libs/ui/**/*.cjs"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "cwd": "libs/ui",
        "command": "tsc --noEmit -p tsconfig.json"
      }
    }
  }
}
