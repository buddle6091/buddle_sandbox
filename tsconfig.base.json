{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@sandbox/ui": [
        "packages/ui/src/index.ts"
      ],
      "@sandbox/ui/*": [
        "packages/ui/src/*"
      ]
    }
  }
}
