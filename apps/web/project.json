{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "root": "apps/web",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["scope:web", "type:app"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/web", "command": "next dev --turbopack -p 3000" }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/.next"],
      "options": { "cwd": "apps/web", "command": "next build" }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "cwd": "apps/web", "command": "next start -p 3000" }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/web/**/*.ts", "apps/web/**/*.tsx", "apps/web/**/*.mjs"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": { "cwd": "apps/web", "command": "tsc --noEmit -p tsconfig.json" }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": { "config": "apps/web/vite.config.ts" }
    }
  }
}
