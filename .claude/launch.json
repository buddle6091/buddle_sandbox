{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook-ui",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "storybook",
        "ui"
      ],
      "port": 6006
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "web"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "apps/web",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
